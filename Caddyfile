{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 4MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The engine owns the API, the admin panel and the legal pages. Everything
	# else - landing, chains, teasers, reveal, the unsealed archive, the manual,
	# robots and sitemap - is the public site.
	#
	# Split here rather than proxied through Next's rewrites so payments,
	# webhooks and media uploads take one hop instead of two, and so the site
	# keeps serving pages when the engine is restarting.
	@engine path /api/* /admin /admin/* /terms /privacy /refunds /content-policy /grievance
	reverse_proxy @engine app:3000 {
		header_up X-Real-IP {remote_host}
	}

	reverse_proxy web:3001 {
		header_up X-Real-IP {remote_host}
	}
}
