{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 4MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# The engine's own JS/CSS, prefixed to avoid colliding with the site's.
	# handle_path strips /engine before proxying, so the app sees /_next/...
	handle_path /engine/* {
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# The engine owns the API, the admin panel and the legal pages.
	@engine path /api/* /admin /admin/* /terms /privacy /refunds /content-policy /grievance
	handle @engine {
		reverse_proxy app:3000 {
			header_up X-Real-IP {remote_host}
		}
	}

	# Everything else is the public site.
	handle {
		reverse_proxy web:3001 {
			header_up X-Real-IP {remote_host}
		}
	}
}
