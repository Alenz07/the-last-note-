# ---------- Kadi — environment ----------
# Copy to .env.local for development. Everything has a safe local default.

# App
APP_NAME=Kadi
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to sign cookies + media URLs. REQUIRED in production (openssl rand -hex 32).
APP_SECRET=dev-only-change-me-dev-only-change-me
# Admin panel password (/admin). REQUIRED in production.
ADMIN_PASSWORD=admin
# Protects /api/cron/* when called by an external scheduler.
CRON_SECRET=dev-cron

# Database — leave DATABASE_URL empty to use embedded PGlite at $DATA_DIR/pg (zero setup).
DATABASE_URL=
DATA_DIR=.data
# Auto-create the 3 demo chains + sample links when the DB is empty (never in production unless set).
SEED_ON_EMPTY=true

# Redis — leave empty to use an in-process memory fallback (fine for single-instance dev).
REDIS_URL=redis://127.0.0.1:6379

# Media storage: local (disk at $DATA_DIR/media) or s3 (Cloudflare R2 / MinIO / S3)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kadi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Payments: mock (TEST MODE, no money) or razorpay
# mock (TEST MODE, no money) | cashfree | razorpay
PAYMENT_GATEWAY=mock

# Cashfree — Dashboard → Developers → API Keys. Webhook → https://<domain>/api/webhooks/cashfree
# (events PAYMENT_SUCCESS_WEBHOOK + PAYMENT_FAILED_WEBHOOK). The webhook is signed
# with this same secret key, so there is no separate webhook secret.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree demands a 10-digit phone per order; Kadi is anonymous, so one stands in for everyone.
CASHFREE_PLACEHOLDER_PHONE=9999999999

# Razorpay — kept as a drop-in alternative. Webhook → https://<domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Web Push (generate with: pnpm vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Legal page placeholders (shown as [brackets] until set)
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_CITY=
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=
GRIEVANCE_ADDRESS=
LEGAL_GATEWAY_NAME=Razorpay
LEGAL_HOSTING_NAME=
LEGAL_MEDIA_NAME=Cloudflare R2
