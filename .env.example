# ---------- Kadi / The Last Note - PRODUCTION ----------
# One file for the whole stack:
#   cp .env.example .env   # then fill everything marked REQUIRED
#   docker compose -f docker-compose.prod.yml up -d --build
#
# 'app' (the engine, :3000) reads this file at runtime via env_file.
# 'web' (the public site, :3001) takes the NEXT_PUBLIC_* values at the bottom
# as BUILD ARGS - they are compiled into the browser bundle, so changing one
# needs `up -d --build web`, not a restart.

# REQUIRED. The bare domain Caddy gets a certificate for (no https://).
DOMAIN=
# REQUIRED. Postgres password for the db service.
POSTGRES_PASSWORD=
# Leave false in production: never auto-create demo chains on a live database.
SEED_ON_EMPTY=false

# ---------- Kadi — environment ----------
# DATABASE_URL, REDIS_URL and NEXT_PUBLIC_APP_URL are set by docker-compose.

# App
APP_NAME=Kadi
# REQUIRED. Signs cookies and media URLs - generate, never reuse the dev value:
#   openssl rand -hex 32
APP_SECRET=
# REQUIRED. Admin panel password (/admin). Not "admin".
ADMIN_PASSWORD=
# REQUIRED. Protects /api/cron/* from the public internet.
CRON_SECRET=

# Database — leave DATABASE_URL empty to use embedded PGlite at $DATA_DIR/pg (zero setup).
# Auto-create the 3 demo chains + sample links when the DB is empty (never in production unless set).

# Redis — leave empty to use an in-process memory fallback (fine for single-instance dev).

# Media storage. Keep s3 in production: local writes to the container and
# every voice note and photo is lost on the next deploy.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=kadi-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Payments: mock (TEST MODE, no money) or razorpay
# mock (TEST MODE, no money) | cashfree | razorpay
PAYMENT_GATEWAY=cashfree

# Cashfree — Dashboard → Developers → API Keys. Webhook → https://<domain>/api/webhooks/cashfree
# (events PAYMENT_SUCCESS_WEBHOOK + PAYMENT_FAILED_WEBHOOK). The webhook is signed
# with this same secret key, so there is no separate webhook secret.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree demands a 10-digit phone per order; Kadi is anonymous, so one stands in for everyone.
CASHFREE_PLACEHOLDER_PHONE=9999999999

# Razorpay — kept as a drop-in alternative. Webhook → https://<domain>/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Web Push (generate with: pnpm vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Legal page placeholders (shown as [brackets] until set)
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_CITY=
GRIEVANCE_NAME=
GRIEVANCE_EMAIL=
GRIEVANCE_ADDRESS=
LEGAL_GATEWAY_NAME=Cashfree
LEGAL_HOSTING_NAME=
LEGAL_MEDIA_NAME=Cloudflare R2

# ---------- public site (web) - BUILD ARGS ----------
# Compiled into the browser bundle at image build time. A rebuild is required
# to change any of these: docker compose -f docker-compose.prod.yml up -d --build web
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
